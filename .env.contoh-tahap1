# .env contoh — SPPK-UKT UNG, Tahap 1, lokal saja (MySQL / XAMPP)
# Cara pakai: salin file ini menjadi `.env` di root proyek Laravel,
# lalu jalankan: php artisan key:generate
# JANGAN commit file `.env` asli ke git. Ini hanya untuk jalan lokal.
# Semua data di sini dummy / contoh, bukan kredensial asli.
#
# Aman untuk lokal? Ya, selama dipakai di laptop sendiri:
# - DB_HOST=127.0.0.1, MySQL XAMPP hanya bisa diakses dari laptop itu
#   dan tidak terekspos ke internet.
# - Username root tanpa password adalah default XAMPP lokal.
# Jangan pakai kombinasi ini di server/production, dan jangan
# memakai password MySQL asli kamu di file contoh ini.

APP_NAME="SPPK-UKT UNG"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_KEY=
APP_TIMEZONE=Asia/Makassar
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database: MySQL (XAMPP) — cara biasa Aldi.
# Pastikan MySQL di XAMPP sudah Start, lalu buat database dulu:
#   di phpMyAdmin, atau: mysql -u root -e "CREATE DATABASE sppk_ukt_ung CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
# Kalau MySQL kamu pakai password, isi DB_PASSWORD dengan password itu.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sppk_ukt_ung
DB_USERNAME=root
DB_PASSWORD=

# Alternatif kalau MySQL belum jalan: SQLite (tanpa XAMPP).
# Hapus blok MySQL di atas dan pakai ini:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite
# DB_FOREIGN_KEYS=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=database
QUEUE_CONNECTION=database

# Email Tahap 1: pakai log saja, bukan SMTP asli.
# Penyedia email resmi belum ditetapkan (PRD Bagian 9 butir 5),
# jadi KF-15 di lokal cukup dibuktikan lewat notifikasi di sistem
# + isi email yang tercatat di storage/logs/laravel.log.
# Jangan isi SMTP asli di sini sebelum penyedia ditetapkan.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@sppk-ukt-ung.local"
MAIL_FROM_NAME="SPPK-UKT UNG"

FILESYSTEM_DISK=local
